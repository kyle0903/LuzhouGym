# ========================================
# 伺服器環境變數配置範本
# ========================================
# 複製此檔案為 .env 並填入實際值

# 環境模式 (development / production)
NODE_ENV=development

# 伺服器端口
PORT=8081

# ========================================
# 資料庫配置 (PostgreSQL)
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=luzhou_gym

# ========================================
# JWT 安全配置
# ========================================
# 請使用強密碼，例如：openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ========================================
# Email / SMTP 配置
# ========================================
SMTP_SERVICE=Gmail
SMTP_USER=
SMTP_PASSWORD=

# ========================================
# 應用程式 URL
# ========================================
APP_URL=http://localhost:8081
FRONTEND_URL=http://localhost:3000

# ========================================
# LINE Pay 支付配置
# ========================================
LINEPAY_CHANNEL_ID=
LINEPAY_CHANNEL_SECRET_KEY=
LINEPAY_VERSION=v3
LINEPAY_SITE=https://sandbox-api-pay.line.me
LINEPAY_RETURN_HOST=http://localhost:8081
LINEPAY_RETURN_CONFIRM_URL=/api/payment/confirm
LINEPAY_RETURN_CANCEL_URL=/api/payment/cancel
